<?xml version="1.0" encoding="UTF-8"?>
<web-app xmlns="https://jakarta.ee/xml/ns/jakartaee"
	xmlns:xsi="https://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="https://jakarta.ee/xml/ns/jakartaee https://jakarta.ee/xml/ns/jakartaee/web-app_6_0.xsd"
	version="6.0" metadata-complete="false">
	
	<welcome-file-list>
		<welcome-file>promo</welcome-file>
	</welcome-file-list>
	
	<servlet>
		<servlet-name>PromoServlet</servlet-name>
		<servlet-class>cat.institutmarianao.promo2.servlet.Promo2Servlet</servlet-class>
	</servlet>

	<servlet-mapping>
		<servlet-name>PromoServlet</servlet-name>
		<url-pattern>/promo</url-pattern>
	</servlet-mapping>

	<session-config>
		<session-timeout>30</session-timeout>
	</session-config>
</web-app>

