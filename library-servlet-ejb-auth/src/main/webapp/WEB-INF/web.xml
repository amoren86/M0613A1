<?xml version="1.0" encoding="UTF-8"?>
<web-app xmlns="https://jakarta.ee/xml/ns/jakartaee"
	xmlns:xsi="https://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="https://jakarta.ee/xml/ns/jakartaee https://jakarta.ee/xml/ns/jakartaee/web-app_6_0.xsd"
	version="6.0" metadata-complete="false">

	<welcome-file-list>
		<welcome-file>library</welcome-file>
	</welcome-file-list>

	<security-role>
		<description>User role, which can check availability of a book</description>
		<role-name>user</role-name>
	</security-role>
	<security-role>
		<description>Librarian role, which can also catalog books</description>
		<role-name>librarian</role-name>
	</security-role>

	<security-constraint>
		<display-name>library constraints</display-name>
		<web-resource-collection>
			<web-resource-name>login</web-resource-name>
			<description>Here we protect the /library path</description>
			<url-pattern>/library</url-pattern>
		</web-resource-collection>
		<auth-constraint>
			<description>Here we describe who has access</description>
			<role-name>user</role-name>
			<role-name>librarian</role-name>
		</auth-constraint>
	</security-constraint>

	<login-config>
		<auth-method>FORM</auth-method>
		<form-login-config>
			<form-login-page>/loginform.jsp</form-login-page>
			<form-error-page>/loginerror.jsp</form-error-page>
		</form-login-config>
	</login-config>

	<session-config>
		<session-timeout>30</session-timeout>
	</session-config>

</web-app>